+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A timeline whose WAL was never offloaded: backup_lsn is stuck at the timeline start while
+    /// the pageserver has already made everything up to 0/5000000 durable.
+    fn state() -> StateSnapshot {
+        StateSnapshot {
+            commit_lsn: Lsn(0x6000000),
+            backup_lsn: Lsn(0x1000000),
+            remote_consistent_lsn: Lsn(0x5000000),
+            cfile_commit_lsn: Lsn(0x6000000),
+            cfile_remote_consistent_lsn: Lsn(0x5000000),
+            cfile_backup_lsn: Lsn(0x1000000),
+            flush_lsn: Lsn(0x6000000),
+            last_log_term: 1,
+            cfile_last_persist_at: std::time::Instant::now(),
+            inmem_flush_pending: false,
+            wal_removal_on_hold: false,
+            peers: vec![],
+        }
+    }
+
+    #[test]
+    fn backup_lsn_holds_wal_when_wal_backup_is_configured() {
+        assert_eq!(calc_horizon_lsn(&state(), None, true), Lsn(0x1000000));
+    }
+
+    #[test]
+    fn backup_lsn_is_ignored_without_wal_backup() {
+        assert_eq!(calc_horizon_lsn(&state(), None, false), Lsn(0x5000000));
+    }
+
+    #[test]
+    fn other_horizons_still_apply_without_wal_backup() {
+        let mut state = state();
+        state.cfile_commit_lsn = Lsn(0x4000000);
+        assert_eq!(calc_horizon_lsn(&state, None, false), Lsn(0x4000000));
+
+        let mut state = self::state();
+        state.flush_lsn = Lsn(0x3000000);
+        assert_eq!(calc_horizon_lsn(&state, None, false), Lsn(0x3000000));
+
+        assert_eq!(
+            calc_horizon_lsn(&self::state(), Some(Lsn(0x2000000)), false),
+            Lsn(0x2000000)
+        );
+    }
+}
